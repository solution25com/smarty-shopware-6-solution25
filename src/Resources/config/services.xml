<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true" public="false" />

        <service id="SmartyAddressValidation\Service\AddressNormalizer" />
        <service id="SmartyAddressValidation.logger" class="Monolog\Logger">
            <argument type="string">SmartyAddressValidation</argument>
            <argument type="collection">
                <argument type="service" id="SmartyAddressValidation.rotatingHandler"/>
            </argument>
        </service>
        <service id="SmartyAddressValidation.rotatingHandler" class="Monolog\Handler\RotatingFileHandler">
            <argument type="string">%kernel.logs_dir%/SmartyAddressValidation-%kernel.environment%.log</argument>
            <argument type="constant">Monolog\Logger::INFO</argument>
        </service>

        <service id="SmartyAddressValidation\Service\SmartyLogger">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="SmartyAddressValidation.logger" />
            <argument type="service" id="Doctrine\DBAL\Connection" />
        </service>

        <service id="SmartyAddressValidation\Service\SmartyClient">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="http_client" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyLogger" />
        </service>

        <service id="SmartyAddressValidation\Service\ZipPrefixLookupService">
            <argument type="service" id="Doctrine\DBAL\Connection" />
            <argument type="service" id="SmartyAddressValidation.logger" />
        </service>
        
        <service id="SmartyAddressValidation\Service\SmartyAutocompleteService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="http_client" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyLogger" />
            <argument type="service" id="SmartyAddressValidation\Service\ZipPrefixLookupService" />
        </service>
        <service id="SmartyAddressValidation\Service\SmartyAddressValidationService">
            <argument type="service" id="SmartyAddressValidation\Service\SmartyClient" />
            <argument type="service" id="SmartyAddressValidation\Service\AddressNormalizer" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyLogger" />
        </service>

        <service id="SmartyAddressValidation\Service\AddressConfirmationService">
            <argument type="service" id="customer_address.repository" />
            <argument type="service" id="country_state.repository" />
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyAddressValidationService" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyLogger" />
        </service>

        <service id="SmartyAddressValidation\Service\AdminAddressVerificationService">
            <argument type="service" id="customer_address.repository" />
            <argument type="service" id="order_address.repository" />
            <argument type="service" id="country_state.repository" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyAddressValidationService" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyLogger" />
            <argument type="service" id="Doctrine\DBAL\Connection" />
        </service>

        <service id="SmartyAddressValidation\Subscriber\AddressValidationSubscriber">
            <argument type="service" id="customer_address.repository" />
            <argument type="service" id="order_address.repository" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyAddressValidationService" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyLogger" />
            <tag name="kernel.event_subscriber" />
        </service>

        <service id="SmartyAddressValidation\Controller\Storefront\SmartyAddressController" public="true">
            <argument type="service" id="SmartyAddressValidation\Service\AddressConfirmationService" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="SmartyAddressValidation\Controller\Storefront\SmartyAutocompleteController" public="true">
            <argument type="service" id="SmartyAddressValidation\Service\SmartyAutocompleteService" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="SmartyAddressValidation\Controller\Api\AdminSmartyAddressController" public="true">
            <argument type="service" id="SmartyAddressValidation\Service\AdminAddressVerificationService" />
            <argument type="service" id="SmartyAddressValidation\Service\SmartyAutocompleteService" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>
    </services>
</container>

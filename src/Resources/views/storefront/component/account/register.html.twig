{% sw_extends '@Storefront/storefront/component/account/register.html.twig' %}

{% block component_account_register_address_billing_fields %}
    {{ parent() }}

    <div class="mt-3">

        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   id="smarty-toggle-billing">
            <label class="form-check-label" for="smarty-toggle-billing">
                Do you want to fill the address with latitude &amp; longitude?
            </label>
        </div>

        <div class="row d-none" id="smarty-billing-coords">

            <div class="form-group col-md-6">
                <label for="smarty-latitude">Latitude</label>
                <input type="text"
                       id="smarty-latitude"
                       name="smartyLatitude"
                       class="form-control"
                       placeholder="47.64424">
            </div>

            <div class="form-group col-md-6">
                <label for="smarty-longitude">Longitude</label>
                <input type="text"
                       id="smarty-longitude"
                       name="smartyLongitude"
                       class="form-control"
                       placeholder="-122.11894">
            </div>

            <div class="col-12 mt-3">
                <button type="button"
                        class="btn btn-primary"
                        id="smarty-fill-from-coordinates">
                    Fill address from coordinates
                </button>
            </div>

        </div>
    </div>
{% endblock %}

{% block component_account_register_address_shipping_fields %}
    {{ parent() }}
    <div class="mt-3" style=" padding:8px;">

        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   id="smarty-toggle-shipping">
            <label class="form-check-label" for="smarty-toggle-shipping">
                Do you want to fill the address with latitude &amp; longitude?
            </label>
        </div>

        <div class="row d-none" id="smarty-shipping-coords">

            <div class="form-group col-md-6">
                <label for="smarty-latitude-shipping">Latitude</label>
                <input type="text"
                       id="smarty-latitude-shipping"
                       name="smartyLatitude"
                       class="form-control"
                       placeholder="47.64424">
            </div>

            <div class="form-group col-md-6">
                <label for="smarty-longitude-shipping">Longitude</label>
                <input type="text"
                       id="smarty-longitude-shipping"
                       name="smartyLongitude"
                       class="form-control"
                       placeholder="-122.11894">
            </div>

            <div class="col-12 mt-3">
                <button type="button"
                        class="btn btn-primary"
                        id="smarty-fill-from-coordinates-shipping">
                    Fill address from coordinates
                </button>
            </div>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            function setupToggle(toggleId, rowId) {
                var toggle = document.getElementById(toggleId);
                var row = document.getElementById(rowId);
                if (!toggle || !row) return;

                function update() {
                    if (toggle.checked) row.classList.remove('d-none');
                    else row.classList.add('d-none');
                }

                toggle.addEventListener('change', update);
                update();
            }

            setupToggle('smarty-toggle-billing',  'smarty-billing-coords');
            setupToggle('smarty-toggle-shipping', 'smarty-shipping-coords');

        });
    </script>
{% endblock %}


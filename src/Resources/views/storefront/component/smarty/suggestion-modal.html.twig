<div class="smarty-modal-backdrop" data-smarty-suggestion-modal>
    <div class="smarty-modal" role="dialog" aria-modal="true" aria-labelledby="smartyModalTitle">
        <div class="smarty-modal-header">
            <h3 id="smartyModalTitle">We couldn’t validate your address</h3>
        </div>

        <div class="smarty-modal-body">
            <p>Please compare and choose the correct address:</p>

            <div class="smarty-modal-compare">
                <div class="smarty-modal-column">
                    <h4 class="smarty-modal-subtitle">You entered</h4>
                    <div class="smarty-original-address-box">
                        <span class="smarty-original-address" data-smarty-original-address></span>
                    </div>
                </div>

                <div class="smarty-modal-column">
                    <h4 class="smarty-modal-subtitle">Suggested address</h4>
                    <div class="smarty-original-address-box">
                        <span class="smarty-original-address" data-smarty-suggestions></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="smarty-modal-footer">
            <button type="button"
                    class="smarty-modal-cancel btn btn-secondary"
                    data-smarty-cancel>
                Keep my address
            </button>
        </div>
    </div>
</div>
